# Copy to .env and fill in. .env is gitignored; never commit real credentials.
#
# Both DealFlow repositories are public. A password committed here is published
# the moment it is pushed, and removing it later does not un-publish it -- the
# only real remedy is to rotate the credential.

DATABASE_URL=mysql+pymysql://dealflow:dealflow@localhost:3306/dealflow

# Signs bearer tokens. Generate a fresh one per deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-not-a-production-secret
